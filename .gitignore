# ==========================================================
#  KOORDINAKSI — .gitignore
#  Secrets & artefak lokal JANGAN pernah di-push ke GitHub.
# ==========================================================

# --- Secrets & environment (semua varian) ---
.env
.env.*
!.env.example
!**/.env.example
**/.env
**/.env.*
!**/.env.example
server/.env
client/.env
client/.env.local
client/.env.production
client/.env.development

# --- Dependencies ---
node_modules/
**/node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# --- Build output ---
dist/
build/
client/dist/
server/dist/
.vite/
**/.vite/

# --- Uploads & media lokal (ephemeral di Railway) ---
uploads/
**/uploads/
!**/uploads/.gitkeep

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Database dumps / exports ---
*.sqlite
*.sqlite-*
*.dump
*.sql
*.csv
*.tsv
*.gz
*.zip
*.rar
!package-lock.json

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Test / coverage / temp ---
coverage/
.phpunit.result.cache
.phpunit.cache
*.tmp
*.temp
*.bak
*.backup

# --- Auth / keys ---
auth.json
*.pem
*.key

# --- Optional local tooling ---
.mcp.json
.npmrc
