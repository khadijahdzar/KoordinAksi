# ==========================================================
#  KOORDINAKSI — .gitignore
#  File sensitif & folder besar tetap aman di lokal,
#  aman untuk di-push ke GitHub.
# ==========================================================

# ----------------------------------------------------------
# 1. SECRETS & FILE SENSITIF (JANGAN PERNAH DI-PUSH)
# ----------------------------------------------------------
/.env
/.env.*
!/.env.example

# Composer auth (API token / kredensial repo privat)
/auth.json

# Kunci aplikasi & OAuth (APP_KEY, passport, dll.)
/storage/*.key

# Jika file di bawah ini berisi token/API key, hapus tanda komentar:
# /.mcp.json
# /.npmrc

# ----------------------------------------------------------
# 2. FOLDER BESAR — di-install ulang via:
#    composer install  &  npm install
# ----------------------------------------------------------
/vendor/
/node_modules/
**/node_modules/
client/node_modules/
server/node_modules/

# ----------------------------------------------------------
# 3. BUILD & CACHE LARAVEL
# ----------------------------------------------------------
/bootstrap/cache/*.php
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# Database SQLite lokal (berisi data asli, bukan sample)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ----------------------------------------------------------
# 4. LOG & CACHE TEST
# ----------------------------------------------------------
/storage/logs
/storage/framework/cache
/storage/framework/sessions
/storage/framework/views
/storage/pail
.phpunit.result.cache
.phpunit.cache

# ----------------------------------------------------------
# 5. NODE / FRONTEND
# ----------------------------------------------------------
/npm-debug.log*
/yarn-error.log*
/pnpm-debug.log*
/.pnp
.pnp.js
.DS_Store

# Vite & build artifacts
/dist/
client/dist/

# ----------------------------------------------------------
# 6. IDE & OS
# ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
.DS_Store

# ----------------------------------------------------------
# 7. LARAVEL / PHP EXTRA
# ----------------------------------------------------------
/Homestead.json
/Homestead.yaml
/.vagrant

# ----------------------------------------------------------
# 8. COVERAGE & TEMP
# ----------------------------------------------------------
/coverage/
*.tmp
*.temp
