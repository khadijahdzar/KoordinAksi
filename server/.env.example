PORT=5000
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/koordinaksi
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Beberapa origin (pisah koma) jika frontend & preview beda domain
# CLIENT_URLS=https://app.example.com,https://www.example.com
NODE_ENV=development

# Midtrans (sandbox; kosongkan = gateway nonaktif)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
DONATION_DISPLAY_GOAL=5000000
